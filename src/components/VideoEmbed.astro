---
import { t } from "../i18n";

interface Props {
  lang: string;
  bilibili?: string;
  youtube?: string;
}
const { lang, bilibili, youtube } = Astro.props;

// 视频 id 白名单:只允许 URL 安全字符(字母/数字/`-`/`_`),不匹配则拒绝渲染。
// 服务端在拼 URL 前显式校验,客户端另有 URL 形态白名单兜底(见下方脚本)。
const VIDEO_ID_RE = /^[A-Za-z0-9_-]+$/;
const safeBilibili = bilibili && VIDEO_ID_RE.test(bilibili) ? bilibili : "";
const safeYoutube = youtube && VIDEO_ID_RE.test(youtube) ? youtube : "";

const hasBoth = Boolean(safeBilibili && safeYoutube);

// 单平台:服务端直接渲染静态 iframe(无 JS 也可观看)
const bilibiliEmbed = safeBilibili
  ? `https://player.bilibili.com/player.html?bvid=${encodeURIComponent(safeBilibili)}&page=1`
  : "";
const youtubeEmbed = safeYoutube
  ? `https://www.youtube.com/embed/${encodeURIComponent(safeYoutube)}`
  : "";
const bilibiliLink = safeBilibili ? `https://www.bilibili.com/video/${safeBilibili}` : "";
const youtubeLink = safeYoutube ? `https://www.youtube.com/watch?v=${safeYoutube}` : "";

const iframeAttrs = {
  class: "h-full w-full",
  loading: "lazy",
  allow: "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share",
  allowfullscreen: true,
  referrerpolicy: "strict-origin-when-cross-origin",
  title: safeYoutube ? "YouTube video player" : "bilibili video player",
} as const;
---

<div class="video-embed my-6">
  {!hasBoth && (
    <div class="aspect-video w-full overflow-hidden border border-border bg-surface-raised">
      {safeBilibili && <iframe src={bilibiliEmbed} {...iframeAttrs}></iframe>}
      {safeYoutube && <iframe src={youtubeEmbed} {...iframeAttrs}></iframe>}
    </div>
  )}

  {
    hasBoth && (
      <div data-video-config data-bilibili={bilibiliEmbed} data-youtube={youtubeEmbed}>
        <div class="aspect-video w-full overflow-hidden border border-border bg-surface-raised">
          <!-- 双平台:iframe 由客户端脚本按环境注入;无 JS 时此容器保持空,
               下方始终渲染两个平台文字链接作为回退 -->
          <div data-video-player class="flex h-full w-full items-center justify-center text-text-muted">
            <span>Video loading…</span>
          </div>
        </div>
      </div>
    )
  }

  {hasBoth && (
    <div
      data-video-switcher
      hidden
      class="mt-3 flex items-center justify-center gap-2"
      aria-label={t(lang, "videoSwitchAria")}
    >
      {safeBilibili && (
        <button
          type="button"
          data-platform="bilibili"
          aria-pressed="false"
          class="inline-flex items-center rounded-full border border-border px-4 py-1.5 text-sm text-text-secondary transition-colors hover:border-brand hover:text-brand"
        >
          B站
        </button>
      )}
      {safeYoutube && (
        <button
          type="button"
          data-platform="youtube"
          aria-pressed="false"
          class="inline-flex items-center rounded-full border border-border px-4 py-1.5 text-sm text-text-secondary transition-colors hover:border-brand hover:text-brand"
        >
          YouTube
        </button>
      )}
    </div>
  )}

  {/* 无 JS 回退:两个平台的文字链接,始终渲染 */}
  <div class="mt-3 flex flex-wrap items-center justify-center gap-3 text-sm">
    {safeBilibili && (
      <a
        href={bilibiliLink}
        target="_blank"
        rel="noopener noreferrer"
        class="text-brand underline underline-offset-3 hover:opacity-80"
      >
        {t(lang, "videoLabelBilibili")}
      </a>
    )}
    {safeYoutube && (
      <a
        href={youtubeLink}
        target="_blank"
        rel="noopener noreferrer"
        class="text-brand underline underline-offset-3 hover:opacity-80"
      >
        {t(lang, "videoLabelYoutube")}
      </a>
    )}
  </div>
</div>

<script>
  // window 单次注册标记:View Transitions 导航后模块脚本可能重新执行,
  // 重复 addEventListener 会累积监听器;仅首次导航时绑定一次。
  // 双平台分流:按访问者环境默认选平台,手动选择用 localStorage 记忆并优先。
  (function () {
    if (window.__videoEmbedBound__) return;
    window.__videoEmbedBound__ = true;

    const KEY = "nettix-video-platform";

    function defaultPlatform(): "bilibili" | "youtube" {
      try {
        const saved = localStorage.getItem(KEY);
        if (saved === "bilibili" || saved === "youtube") return saved;
      } catch {
        /* localStorage unavailable; fall through to auto detection. */
      }
      const lang = (navigator.language || "").toLowerCase();
      let tz = "";
      try {
        tz = Intl.DateTimeFormat().resolvedOptions().timeZone || "";
      } catch {
        /* Intl unavailable. */
      }
      return lang.startsWith("zh") || tz.startsWith("Asia/") ? "bilibili" : "youtube";
    }

    // 客户端只接受服务端校验通过后拼好的固定 URL 形态(白名单正则,内含
    // id 字符集约束),任何不匹配的 URL 直接拒绝渲染,不进入 DOM。
    const PLATFORM_URL_RE: Record<string, RegExp> = {
      bilibili: /^https:\/\/player\.bilibili\.com\/player\.html\?bvid=[A-Za-z0-9_-]+&page=1$/,
      youtube: /^https:\/\/www\.youtube\.com\/embed\/[A-Za-z0-9_-]+$/,
    };

    // 用 createElement + 属性赋值构建 iframe(不走 innerHTML 字符串拼接,
    // src 只作为属性写入,天然免疫 HTML 注入)。
    function frameFromUrl(url: string): HTMLIFrameElement {
      const frame = document.createElement("iframe");
      frame.src = url;
      frame.className = "h-full w-full";
      frame.loading = "lazy";
      frame.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      frame.allowFullscreen = true;
      frame.referrerPolicy = "strict-origin-when-cross-origin";
      frame.title = "video player";
      return frame;
    }

    function syncSwitcher(root: HTMLElement, platform: string) {
      const switcher = root.querySelector<HTMLElement>("[data-video-switcher]");
      if (!switcher) return;
      switcher.hidden = false;
      switcher.querySelectorAll("button").forEach((btn) => {
        btn.setAttribute(
          "aria-pressed",
          btn.getAttribute("data-platform") === platform ? "true" : "false",
        );
      });
    }

    function renderPlatform(root: HTMLElement, platform: string) {
      const player = root.querySelector<HTMLElement>("[data-video-player]");
      const url = root.dataset[platform];
      const allow = PLATFORM_URL_RE[platform];
      if (!player || !url || !allow || !allow.test(url)) return; // 拒绝非法 id/URL
      player.replaceChildren(frameFromUrl(url));
      syncSwitcher(root, platform);
    }

    document.querySelectorAll<HTMLElement>("[data-video-config]").forEach((root) => {
      renderPlatform(root, defaultPlatform());
    });

    document.addEventListener("click", (e) => {
      const btn = (e.target as Element | null)?.closest?.(
        "[data-video-switcher] button",
      );
      if (!btn) return;
      const root = btn.closest<HTMLElement>("[data-video-config]");
      const platform = btn.getAttribute("data-platform");
      if (!root || !platform) return;
      try {
        localStorage.setItem(KEY, platform);
      } catch {
        /* ignore */
      }
      renderPlatform(root, platform);
    });
  })();
</script>
