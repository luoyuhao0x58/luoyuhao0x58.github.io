---
import { t } from "../i18n";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  lang: string;
  /** 是否显示"目录"标题(手机面板/折叠条自带标题时可关掉,避免重复) */
  showHeading?: boolean;
}
const { headings, lang, showHeading = true } = Astro.props;

// 只保留插件分配的锚点 id(6 位纯小写字母,去 i/l/o):排除 sr-only(脚注自动标题等)与无锚点标题。
const valid = headings.filter((h) => /^[abcdefghjkmnpqrstuvwxyz]{6}$/.test(h.slug));

// 目录起始级别:有 h1 从 h1 开始;无 h1 有 h2 从 h2;都没有则不展示目录。
const startDepth = valid.some((h) => h.depth === 1)
  ? 1
  : valid.some((h) => h.depth === 2)
    ? 2
    : null;

// 两级树:起始级别为顶层,下一级嵌套其下。
const items: Array<{ h: Heading; children: Heading[] }> = [];
let current: (typeof items)[number] | undefined;
if (startDepth) {
  for (const h of valid) {
    if (h.depth === startDepth) {
      current = { h, children: [] };
      items.push(current);
    } else if (h.depth === startDepth + 1 && current) {
      current.children.push(h);
    }
  }
}
---

{startDepth && items.length > 0 && (
  <nav class="toc" aria-label={t(lang, "tocTitle")}>
    {showHeading && (
      <p class="text-base font-semibold text-text-secondary">{t(lang, "tocTitle")}</p>
    )}
    <ul class="mt-2 space-y-1 border-s border-border text-sm">
      {items.map((item) => (
        <li>
          <a
            href={`#${item.h.slug}`}
            class="px-2 py-1 text-text-secondary transition-colors hover:bg-[var(--toc-hover)] hover:text-text-primary"
          >
            {item.h.text}
          </a>
          {item.children.length > 0 && (
            <ul class="ms-3 mt-1 space-y-1 border-s border-border">
              {item.children.map((child) => (
                <li>
                  <a
                    href={`#${child.slug}`}
                    class="px-2 py-0.5 text-text-secondary transition-colors hover:bg-[var(--toc-hover)] hover:text-text-primary"
                  >
                    {child.text}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
)}
