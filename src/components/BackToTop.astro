---
// 浮动返回顶部按钮(文章页右下角,方形小按钮)。
// 滚动超过一屏的约 1/3(300px)才显示;fixed 定位层在内容之上(z-40)。
// 事件委托 + window 单次注册标记,View Transitions 导航安全:
// 按钮只存在于文章页,导航到列表页后 getElementById 为空则 no-op。
import ArrowUp from "./icons/ArrowUp.astro";
import { t } from "../i18n";

interface Props {
  lang: string;
}
const { lang } = Astro.props;
---

<button
  id="back-to-top"
  type="button"
  aria-label={t(lang, "backToTop")}
  class="fixed bottom-4 end-4 z-40 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-border bg-surface/30 text-text-muted backdrop-blur transition-colors hover:border-brand hover:text-brand"
>
  <ArrowUp class="h-4 w-4" />
</button>

<style>
  #back-to-top {
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }
  #back-to-top.is-visible {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script>
  (function () {
    if (window.__backToTopBound__) return;
    window.__backToTopBound__ = true;

    const btn = () => document.getElementById("back-to-top");

    function update() {
      const b = btn();
      if (!b) return;
      b.classList.toggle("is-visible", window.scrollY > 300);
    }

    window.addEventListener("scroll", update, { passive: true });
    document.addEventListener("astro:page-load", update);
    document.addEventListener("click", (e) => {
      if (!(e.target instanceof Element)) return;
      if (!e.target.closest("#back-to-top")) return;
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" });
    });
    update();
  })();
</script>
