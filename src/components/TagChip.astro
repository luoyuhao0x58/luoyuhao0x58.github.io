---
// 标签胶囊组件:全站标签统一外观(方形小圆角,图标与文字垂直居中)。
// 颜色:缺省按 name 哈希从内置柔和色板稳定取色(同一标签永远同色、跨语言一致);
//       可显式传 fg/bg 覆盖。深色模式由 CSS 从前景色自动派生,无需另配。
import Tag from "./icons/Tag.astro";

interface Props {
  /** 显示文案(已按语言翻译) */
  label: string;
  /** 用于哈希取色的稳定标识(建议传英文 tag key,保证跨语言同色);缺省用 label */
  name?: string;
  /** 可选链接(指向该标签的列表页) */
  href?: string;
  /** 显式前景/背景色,缺省按 name 从色板取 */
  fg?: string;
  bg?: string;
}

const { label, name, href, fg, bg } = Astro.props;

// 柔和色板(低饱和、不鲜艳):fg = 文字色,bg = 浅底。
// 深色模式自动派生(bg 提亮 fg、叠透明底),无需深色板。
// 色相区间刻意避开元信息行三图标色(分类金≈44°/发布绿≈152°/更新藕粉≈350°),
// 取 84°-305° 多彩分布(含黄绿暖调),标签与图标不撞色。
const palette = [
  { fg: "#7ea249", bg: "#eef3e6" }, // 黄绿
  { fg: "#5c8349", bg: "#e8efe4" }, // 橄榄
  { fg: "#4e8997", bg: "#e6f0f2" }, // 青
  { fg: "#456b92", bg: "#e6ecf2" }, // 蓝
  { fg: "#404b77", bg: "#e9eaf3" }, // 藏蓝
  { fg: "#58569f", bg: "#ebe9f5" }, // 蓝紫
  { fg: "#7d5ca3", bg: "#efeaf4" }, // 紫
  { fg: "#a4659f", bg: "#f3ebf2" }, // 玫紫
];

// 稳定哈希(正整数):同一 name 永远落在同一色
const seed = name ?? label;
let hash = 7;
for (const ch of seed) hash = (hash * 31 + (ch.codePointAt(0) ?? 0)) >>> 0;
const fallback = palette[hash % palette.length];
const chipFg = fg ?? fallback.fg;
const chipBg = bg ?? fallback.bg;
const chipStyle = `--chip-fg:${chipFg};--chip-bg:${chipBg}`;
---

{href ? (
  <a href={href} class="tag-chip" style={chipStyle}>
    <Tag class="h-3 w-3" />
    <span>{label}</span>
  </a>
) : (
  <span class="tag-chip" style={chipStyle}>
    <Tag class="h-3 w-3" />
    <span>{label}</span>
  </span>
)}

<style>
  .tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.1875rem;
    border-radius: 0.375rem; /* 方形小圆角 */
    padding: 0.125rem 0.1875rem 0.0625rem; /* 上2 左右3 下1(底部减 1px) */
    font-size: 0.75rem;
    line-height: 1.5;
    font-family: var(--font-mono);
    white-space: nowrap;
    color: var(--chip-fg);
    background-color: var(--chip-bg);
  }
  a.tag-chip {
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  a.tag-chip:hover {
    opacity: 0.75;
  }
  /* 文字微抬:与实心图标视觉对齐(不改变布局盒) */
  .tag-chip > span {
    transform: translateY(-1px);
  }
  /* 深色模式:前景提亮(72% 前景 + 白),背景改为前景色 20% 透明叠底 */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]):not([data-theme="dark"]) .tag-chip {
      color: color-mix(in srgb, var(--chip-fg) 72%, white);
      background-color: color-mix(in srgb, var(--chip-fg) 20%, transparent);
    }
  }
  :root[data-theme="dark"] .tag-chip {
    color: color-mix(in srgb, var(--chip-fg) 72%, white);
    background-color: color-mix(in srgb, var(--chip-fg) 20%, transparent);
  }
</style>
