---
// 站点导航条。
// - 桌面/平板(≥640px): logo 左 + 导航右(persist),右侧功能区:文A 语言下拉。
// - 手机(<640px): 导航与语言全部收纳进 ⋮ 竖三点工具横条(点击展开):第一行 5 个导航按钮,
//   第二行语言切换(与平板/桌面同一 LangSwitcher 组件,三端一致)。
//   目录按钮(≡)在 ⋮ 左侧(仅文章页显示)。折叠态下无分界线。
// persist 策略: logo+桌面导航为 persist 容器(导航不闪);手机 ⋮ 菜单含语言 targets(随页面
// 上下文变化),必须在 persist 容器外,每次导航 SSR 更新。语言切换走整页加载(data-astro-reload)。
// 语言切换器、导航链接、手机 ⋮ 菜单分别拆自 HeaderNav.astro / HeaderMobileMenu.astro。
import { langPath, t } from "../i18n";
import type { Locale } from "../i18n";
import { getActiveLangs } from "../lib/active-langs";
import HeaderMobileMenu from "./HeaderMobileMenu.astro";
import HeaderNav from "./HeaderNav.astro";
import LangSwitcher from "./LangSwitcher.astro";
import List from "./icons/List.astro";

interface Props {
  lang: string;
  /** Explicit per-language target URLs (article pages pass parallel-slug targets). */
  targets?: Partial<Record<Locale, string>>;
  /** Article title (post pages only): mobile scrolls past the meta divider to swap it into the logo slot. */
  title?: string;
}
const { lang, targets, title } = Astro.props;
const pathname = Astro.url.pathname;
const prefix = `/${langPath(lang)}`;
// 活跃语言(有文章才渲染):语言切换器只列有内容的语言。
const activeLangs = await getActiveLangs();
const navLinkClass =
  "font-nav shrink-0 rounded-full px-2.5 py-1.5 text-text-secondary transition-colors hover:bg-surface-alt hover:text-text-primary sm:px-3";
const navItems = [
  { href: `${prefix}/`, label: t(lang, "navHome") },
  { href: `${prefix}/posts/`, label: t(lang, "navPosts") },
  { href: `${prefix}/category/`, label: t(lang, "navCategories") },
  { href: `${prefix}/series/`, label: t(lang, "navSeries") },
  { href: `${prefix}/about/`, label: t(lang, "navAbout") },
];
---

<header class="site-header-root sticky top-0 z-10 border-b border-border">
  <div class="mx-auto flex h-14 w-full max-w-6xl items-center justify-between gap-2 px-2 sm:px-6">
    <!-- logo(左) + 桌面导航(右,≥640px)。整个 header 以独立 view-transition group 瞬时替换
         (见 base.css .site-header-root):不参与 root 淡入淡出,导航时不闪;
         同语言页面间 header 内容相同,单帧替换无感知;语言切换走整页加载(SSR 重渲)。 -->
    <div class="flex min-w-0 flex-1 items-center justify-between gap-2">
      <a
        href={`${prefix}/`}
        class="site-logo flex shrink-0 items-center gap-1.5 text-lg font-semibold tracking-wide xl:ml-10"
      >
        <span class="site-logo-text">{t(lang, "siteName")}</span>
        {title && (
          <span class="site-logo-title" title={title}>
            {title}
          </span>
        )}
      </a>
      <HeaderNav items={navItems} linkClass={navLinkClass} />
    </div>
    <!-- 分界线:导航(左)与功能按钮(右)分隔;手机端折叠收纳后不需要,隐藏 -->
    <div class="header-divider h-4 w-px shrink-0 bg-border" aria-hidden="true"></div>
    <!-- 手机文章页目录按钮(≡):仅 <640px 且 body[data-has-toc](文章页)时由 CSS 显示 -->
    <button
      id="toc-nav-btn"
      type="button"
      class="toc-nav-btn inline-flex shrink-0 cursor-pointer items-center rounded-full p-2 text-text-secondary transition-colors hover:bg-surface-alt hover:text-text-primary"
      aria-label={t(lang, "tocTitle")}
      aria-expanded="false"
      aria-controls="mobile-toc-panel"
    >
      <List class="h-5 w-5" />
    </button>
    <!-- 手机 ⋮ 弹出列表(<640px):点击展开,上区语言切换工具 + 下区导航链接(见 HeaderMobileMenu.astro)。
         位于 persist 容器外(语言 targets 随页面 SSR 更新) -->
    <HeaderMobileMenu
      lang={lang}
      currentPath={pathname}
      activeLangs={activeLangs}
      targets={targets}
      navItems={navItems}
    />
    <!-- 语言切换(≥640px):文A 图标直达下拉;手机隐藏(入口在 ⋮ 横条,同一组件) -->
    <span class="header-lang shrink-0">
      <LangSwitcher currentPath={pathname} langs={activeLangs} targets={targets} />
    </span>
  </div>
</header>

<style>
  /* 文章标题占位(仅文章页渲染,默认隐藏):手机滚动过标题区分割线后,
     JS 给 .site-logo 加 data-title-swap,用标题替换 logo 文字。
     文字颜色与导航链接按钮一致(--text-secondary);单行 + 省略号;
     宽度不超目录按钮前(靠 flex 收缩 + min-width:0)。 */
  .site-logo {
    /* logo 区域无衬线(与标题一致,角色:logo/标题无衬线;UI 默认等宽) */
    font-family: var(--font-sans);
  }
  .site-logo-title {
    display: none;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    /* 截断点提前 1em:标题与目录按钮之间留白 */
    padding-inline-end: 1em;
    color: var(--text-secondary);
    font-size: 1rem; /* 较导航链接(0.875rem)大一号 */
    font-weight: 500;
    letter-spacing: normal;
  }
  .site-logo[data-title-swap] .site-logo-text {
    display: none;
  }
  .site-logo[data-title-swap] .site-logo-title {
    display: block;
  }
  /* 折叠态:分界线与 header 右侧语言入口在手机隐藏(⋮ 菜单本体显隐规则见 HeaderMobileMenu.astro) */
  @media (max-width: 639px) {
    .header-divider {
      display: none;
    }
    .header-lang {
      display: none;
    }
    /* 允许 logo 收缩:标题过长时在目录按钮前截断省略,而非溢出到右侧 */
    .site-logo {
      flex-shrink: 1;
      min-width: 0;
    }
  }
</style>

<script>
  // window 单次注册标记:View Transitions 导航后模块脚本可能重新执行,
  // 重复 addEventListener 会累积监听器;仅首次导航时绑定一次。
  (function () {
    if (window.__headerBound__) return;
    // 守卫与绑定解耦:只要有 .site-logo(全站 header 都有)就绑定监听;
    // 绑定不依赖文章页元素,判定在 update 内每次重新查询(见下)。
    const siteLogo = document.querySelector<HTMLElement>(".site-logo");
    if (!siteLogo) return;
    window.__headerBound__ = true;

    // 手机端文章页:滚动到标题区分割线(.post-meta-divider)开始被吸顶导航条遮住后,
    // 用文章标题替换导航条 logo 文字(仅移动端 <640px;平板/桌面不参与)。
    const mq = window.matchMedia("(max-width: 639px)");
    const update = () => {
      // 每次重新查询:View Transitions 导航会整体替换 header/文章 DOM,
      // 绑定期闭包捕获的一次性引用会过期(指向已脱离文档的旧节点)。
      const logo = document.querySelector<HTMLElement>(".site-logo");
      const divider = document.querySelector<HTMLElement>(".post-meta-divider");
      const logoTitle = logo?.querySelector<HTMLElement>(".site-logo-title");
      // 非文章页(无分割线/无标题占位)或桌面(>639px):不替换
      if (!logo || !divider || !logoTitle || !mq.matches) {
        logo?.removeAttribute("data-title-swap");
        return;
      }
      const headerBottom =
        document
          .querySelector<HTMLElement>(".site-header-root")
          ?.getBoundingClientRect().bottom ?? 57;
      logo.toggleAttribute(
        "data-title-swap",
        divider.getBoundingClientRect().top < headerBottom
      );
    };
    window.addEventListener("scroll", update, { passive: true });
    mq.addEventListener("change", update);
    // 题图加载失败等导致布局变化时重新判定(与 post-toc.js 同事件)
    window.addEventListener("toc-realign", update);
    update();
  })();
</script>
