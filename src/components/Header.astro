---
// 站点导航条。
// - 桌面/平板(≥640px): logo 左 + 导航右(persist),右侧功能区:文A 语言下拉。
// - 手机(<640px): 导航与语言全部收纳进 ⋮ 竖三点工具横条(点击展开):第一行 5 个导航按钮,
//   第二行语言切换(与平板/桌面同一 LangSwitcher 组件,三端一致)。
//   目录按钮(≡)在 ⋮ 左侧(仅文章页显示)。折叠态下无分界线。
// persist 策略: logo+桌面导航为 persist 容器(导航不闪);手机 ⋮ 菜单含语言 targets(随页面
// 上下文变化),必须在 persist 容器外,每次导航 SSR 更新。语言切换走整页加载(data-astro-reload)。
import { langPath, t } from "../i18n";
import type { Locale } from "../i18n";
import LangSwitcher from "./LangSwitcher.astro";
import List from "./icons/List.astro";
import MoreVertical from "./icons/MoreVertical.astro";

interface Props {
  lang: string;
  /** Explicit per-language target URLs (article pages pass parallel-slug targets). */
  targets?: Partial<Record<Locale, string>>;
  /** Article title (post pages only): mobile scrolls past the meta divider to swap it into the logo slot. */
  title?: string;
}
const { lang, targets, title } = Astro.props;
const pathname = Astro.url.pathname;
const prefix = `/${langPath(lang)}`;
const navLinkClass =
  "font-nav shrink-0 rounded-full px-2.5 py-1.5 text-text-secondary transition-colors hover:bg-surface-alt hover:text-text-primary sm:px-3";
const navItems = [
  { href: `${prefix}/`, label: t(lang, "navHome") },
  { href: `${prefix}/posts/`, label: t(lang, "navPosts") },
  { href: `${prefix}/category/`, label: t(lang, "navCategories") },
  { href: `${prefix}/series/`, label: t(lang, "navSeries") },
  { href: `${prefix}/about/`, label: t(lang, "navAbout") },
];
---

<header class="site-header-root sticky top-0 z-10 border-b border-border bg-surface/90 backdrop-blur">
  <div class="mx-auto flex h-14 w-full max-w-6xl items-center justify-between gap-2 px-4 sm:px-6">
    <!-- logo(左) + 桌面导航(右,≥640px)。整个 header 以独立 view-transition group 瞬时替换
         (见 base.css .site-header-root):不参与 root 淡入淡出,导航时不闪;
         同语言页面间 header 内容相同,单帧替换无感知;语言切换走整页加载(SSR 重渲)。 -->
    <div class="flex min-w-0 flex-1 items-center justify-between gap-2">
      <a
        href={`${prefix}/`}
        class="site-logo shrink-0 text-lg font-semibold tracking-wide"
      >
        <span class="site-logo-text">{t(lang, "siteName")}</span>
        {title && (
          <span class="site-logo-title" title={title}>
            {title}
          </span>
        )}
      </a>
      <nav
        class="header-nav hidden min-w-0 items-center gap-1.5 overflow-x-auto text-sm sm:flex sm:gap-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        aria-label="Main"
      >
        {navItems.map((item) => (
          <a href={item.href} class={navLinkClass}>
            {item.label}
          </a>
        ))}
      </nav>
    </div>
    <!-- 分界线:导航(左)与功能按钮(右)分隔;手机端折叠收纳后不需要,隐藏 -->
    <div class="header-divider h-4 w-px shrink-0 bg-border" aria-hidden="true"></div>
    <!-- 手机文章页目录按钮(≡):仅 <640px 且 body[data-has-toc](文章页)时由 CSS 显示 -->
    <button
      id="toc-nav-btn"
      type="button"
      class="toc-nav-btn inline-flex shrink-0 cursor-pointer items-center rounded-full p-2 text-text-secondary transition-colors hover:bg-surface-alt hover:text-text-primary"
      aria-label={t(lang, "tocTitle")}
      aria-expanded="false"
      aria-controls="mobile-toc-panel"
    >
      <List class="h-5 w-5" />
    </button>
    <!-- 手机 ⋮ 弹出列表(<640px):点击展开,分上下两区——
         上区:工具按钮(PC 端分割线右侧按钮,如语言切换),从右到左排列、排满换行;
         下区:导航链接,从上到下、文字右对齐;
         列表宽度 = 最长导航按钮文本 + 边距。目录按钮(≡)独立不受影响。
         位于 persist 容器外(语言 targets 随页面 SSR 更新) -->
    <details class="nav-mobile-menu">
      <summary
        class="flex cursor-pointer list-none select-none items-center rounded-full p-2 text-text-secondary transition-colors hover:bg-surface-alt hover:text-text-primary [&::marker]:hidden [&::-webkit-details-marker]:hidden"
        aria-label={t(lang, "toolsMenu")}
      >
        <MoreVertical class="h-5 w-5" />
      </summary>
      <div class="nav-mobile-bar">
        <!-- 上区:工具按钮(从右到左,排满换行) -->
        <div class="nav-mobile-tools">
          <LangSwitcher currentPath={pathname} targets={targets} />
        </div>
        <!-- 下区:导航链接(从上到下,文字右对齐) -->
        <nav class="nav-mobile-links" aria-label="Main">
          {navItems.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      </div>
    </details>
    <!-- 语言切换(≥640px):文A 图标直达下拉;手机隐藏(入口在 ⋮ 横条,同一组件) -->
    <span class="header-lang shrink-0">
      <LangSwitcher currentPath={pathname} targets={targets} />
    </span>
  </div>
</header>

<style>
  /* ⋮ 菜单仅手机显示;折叠态下分界线与 header 右侧语言入口在手机隐藏 */
  .nav-mobile-menu {
    display: none;
  }
  @media (max-width: 639px) {
    .nav-mobile-menu {
      display: block;
      /* ⋮ 贴右缘:抵消容器 px-4(1rem),图标距视口右缘仅剩自身 p-2 */
      margin-inline-end: -1rem;
    }
    .header-divider {
      display: none;
    }
    .header-lang {
      display: none;
    }
  }
  /* 弹出列表:从 ⋮ 右下弹出,宽度自适应 = 最长导航文本 + 边距,
     面板样式(全边框 + 圆角 + 阴影)。无外内边距:上区工具分隔线与
     下区导航 hover 横条贴到列表左右边缘 */
  .nav-mobile-bar {
    position: absolute;
    /* 顶边对齐导航条内容区底边:列表上边框正好覆盖导航条底边框,
       两条 1px 线重叠成一条,视觉上边框“合并” */
    top: 100%;
    /* 右缘内移 0.5rem:⋮ 按钮有 -1rem 负外边距贴视口右缘,
       列表若 right:0 会跟着贴边导致右边框几乎看不见 */
    inset-inline-end: 0.5rem;
    z-index: 30;
    width: max-content;
    min-width: calc(100vw * 4 / 9); /* 至少屏幕宽度 4/9 */
    max-width: min(20rem, calc(100vw - 1rem));
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 0 0 0.625rem 0.625rem; /* 上面两角直角(与导航条边框合并),下面两角保留圆角 */
    background: color-mix(in srgb, var(--surface) 96%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: var(--ntx-shadow-md);
  }
  /* 上区:工具按钮,从右到左排列、排满换行(语言按钮在右上);
     按钮间空隙靠 gap(不靠按钮内边距),一行可放下 3 个 */
  .nav-mobile-tools {
    display: flex;
    flex-wrap: wrap;
    flex-direction: row-reverse;
    gap: 0.5rem;
    padding: 0.5625rem 1rem 0.75rem; /* 左右内边距与导航链接按钮一致(1rem);上下各增一半、左右减半过 */
    border-bottom: 1px solid var(--border);
  }
  /* 工具按钮去掉自身内边距(仅此下拉列表内生效,不影响桌面/平板):
     空隙由上方 gap 分割,增加按钮时一行能放下 3 个 */
  .nav-mobile-tools :global(.lang-switcher summary) {
    padding: 0;
  }
  /* 下区:导航链接,从上到下、整行按钮文本左对齐;
     无水平内边距 → 链接撑满列表宽,hover 横条贴边 */
  .nav-mobile-links {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0;
  }
  .nav-mobile-links a {
    display: block;
    /* start:跟随页面方向(LTR 左对齐;RTL 如阿拉伯语自动右对齐) */
    text-align: start;
    padding: 0.375rem 1rem; /* 左右内边距加大(0.75rem → 1rem) */
    font-size: 0.875rem;
    color: var(--text-secondary);
    transition: color 0.15s, background-color 0.15s;
  }
  /* hover 高亮横条:与语言菜单/代码块行 hover 一致(--code-line-hover 浅色横条) */
  .nav-mobile-links a:hover {
    background: var(--code-line-hover);
    color: var(--text-primary);
  }

  /* 文章标题占位(仅文章页渲染,默认隐藏):手机滚动过标题区分割线后,
     JS 给 .site-logo 加 data-title-swap,用标题替换 logo 文字。
     文字颜色与导航链接按钮一致(--text-secondary);单行 + 省略号;
     宽度不超目录按钮前(靠 flex 收缩 + min-width:0)。 */
  .site-logo {
    /* logo 区域无衬线(与标题一致,角色:logo/标题无衬线;UI 默认等宽) */
    font-family: var(--font-sans);
  }
  .site-logo-title {
    display: none;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    /* 截断点提前 1em:标题与目录按钮之间留白 */
    padding-inline-end: 1em;
    color: var(--text-secondary);
    font-size: 1rem; /* 较导航链接(0.875rem)大一号 */
    font-weight: 500;
    letter-spacing: normal;
  }
  .site-logo[data-title-swap] .site-logo-text {
    display: none;
  }
  .site-logo[data-title-swap] .site-logo-title {
    display: block;
  }
  @media (max-width: 639px) {
    /* 允许 logo 收缩:标题过长时在目录按钮前截断省略,而非溢出到右侧 */
    .site-logo {
      flex-shrink: 1;
      min-width: 0;
    }
  }
</style>

<script>
  // 渐进增强:点击 ⋮ 横条外部时自动收起(无 JS 时 details 仍可原生开合)。
  document.addEventListener("click", (e) => {
    const inside = (e.target as Element | null)?.closest?.(".nav-mobile-menu");
    document
      .querySelectorAll<HTMLDetailsElement>(".nav-mobile-menu[open]")
      .forEach((details) => {
        if (!inside?.contains(details)) {
          details.removeAttribute("open");
        }
      });
  });

  // 手机端文章页:滚动到标题区分割线(.post-meta-divider)开始被吸顶导航条遮住后,
  // 用文章标题替换导航条 logo 文字(仅移动端 <640px;平板/桌面不参与)。
  const siteLogo = document.querySelector<HTMLElement>(".site-logo");
  const divider = document.querySelector<HTMLElement>(".post-meta-divider");
  if (siteLogo && divider && siteLogo.querySelector(".site-logo-title")) {
    const mq = window.matchMedia("(max-width: 639px)");
    const update = () => {
      if (!mq.matches) {
        siteLogo.removeAttribute("data-title-swap");
        return;
      }
      const headerBottom =
        document
          .querySelector<HTMLElement>(".site-header-root")
          ?.getBoundingClientRect().bottom ?? 57;
      siteLogo.toggleAttribute(
        "data-title-swap",
        divider.getBoundingClientRect().top < headerBottom
      );
    };
    window.addEventListener("scroll", update, { passive: true });
    mq.addEventListener("change", update);
    // 题图加载失败等导致布局变化时重新判定(与 post-toc.js 同事件)
    window.addEventListener("toc-realign", update);
    update();
  }
</script>
