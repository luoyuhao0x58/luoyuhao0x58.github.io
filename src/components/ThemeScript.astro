<!-- 主题初始化脚本:必须放在 <head>,在首帧前应用 data-theme,避免主题闪烁。
     三种状态:light / dark / auto(无 data-theme 属性 = 跟随系统)。
     与 ThemeToggle.astro 的按钮配合,用事件委托处理点击。 -->
<script is:inline>
  (function () {
    const KEY = "nettix-theme";
    const ORDER = ["light", "dark", "auto"];
    const ICONS = { light: "☀️", dark: "🌙", auto: "🔄" };

    function current() {
      const t = document.documentElement.getAttribute("data-theme");
      return t === "light" || t === "dark" ? t : "auto";
    }
    function setState(t) {
      const root = document.documentElement;
      if (t === "auto") root.removeAttribute("data-theme");
      else root.setAttribute("data-theme", t);
      try {
        localStorage.setItem(KEY, t);
      } catch {
        /* localStorage unavailable (private mode / blocked); theme still applies. */
      }
      root.setAttribute("data-theme-state", t);
    }
    function updateButton() {
      const btn = document.getElementById("theme-toggle");
      if (!btn) return;
      const t = current();
      const icon = btn.querySelector("[data-theme-icon]");
      const label = btn.querySelector("[data-theme-label]");
      if (icon) icon.textContent = ICONS[t] || "🔄";
      if (label) {
        const key = "label" + t.charAt(0).toUpperCase() + t.slice(1);
        label.textContent = btn.dataset[key] || t;
      }
      btn.setAttribute("data-theme-state", t);
    }

    let saved = "auto";
    try {
      saved = localStorage.getItem(KEY) || "auto";
    } catch {
      /* localStorage unavailable (private mode / blocked); fall back to auto. */
    }
    setState(saved);

    document.addEventListener("DOMContentLoaded", updateButton);
    // View Transitions 导航完成后重新同步:换页时 DOMContentLoaded 不会再次触发,
    // 若 head 内脚本重跑时序不可控,这里兜底保证主题与按钮状态一致。
    document.addEventListener("astro:page-load", function () {
      let saved = "auto";
      try {
        saved = localStorage.getItem(KEY) || "auto";
      } catch {
        /* ignore */
      }
      setState(saved);
      updateButton();
    });
    // View Transitions swap 会用新页面的 <html> 属性覆盖 documentElement,
    // 而新页面是构建期生成的、不带 data-theme -> 主题瞬间丢失(系统深色时闪黑夜)。
    // after-swap 在 DOM 替换后、动画渲染前同步触发,立即恢复 localStorage 主题。
    document.addEventListener("astro:after-swap", function () {
      let saved = "auto";
      try {
        saved = localStorage.getItem(KEY) || "auto";
      } catch {
        /* ignore */
      }
      setState(saved);
      updateButton();
    });
    document.addEventListener("click", function (e) {
      const el = e.target && e.target.closest ? e.target.closest("#theme-toggle") : null;
      if (!el) return;
      setState(ORDER[(ORDER.indexOf(current()) + 1) % ORDER.length]);
      updateButton();
    });
  })();
</script>
