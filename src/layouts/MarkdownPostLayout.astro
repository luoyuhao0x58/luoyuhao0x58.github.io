---
import "../styles/global.css";
import PostHero from "../components/PostHero.astro";
import PostMeta from "../components/PostMeta.astro";
import PostSeoHead from "../components/PostSeoHead.astro";
import Toc from "../components/Toc.astro";
import ScrollbarOverlay from "../components/ScrollbarOverlay.astro";
import CloudflareAnalytics from "../components/CloudflareAnalytics.astro";
import CodeBlockActions from "../components/CodeBlockActions.astro";
import BackToTop from "../components/BackToTop.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ThemeScript from "../components/ThemeScript.astro";
import ViewTransitionDisable from "../components/ViewTransitionDisable.astro";
import VideoEmbed from "../components/VideoEmbed.astro";
import { ClientRouter } from "astro:transitions";
import { codeFromPath, langPath, languages, t } from "../i18n";
import type { Locale } from "../i18n";
import { categoryLabels, taxonomyLabel } from "../taxonomy";
import { postUpdatedAt } from "../lib/post-meta";
import { isValidAnchorSlug } from "../lib/anchor";
import { getActiveLangs } from "../lib/active-langs";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  pubDate?: Date;
  tags?: string[];
  /** 内容大类(映射表 key,标题区显示) */
  category?: string;
  /** 专栏 id(映射表 key,标题区显示);无专栏不渲染 */
  series?: string;
  /** 最后修改时间(可选);缺省回退首次发布 */
  updated?: Date;
  /** 正文摘要(可选),标题区显示 */
  excerpt?: string;
  image?: { url: string; alt: string };
  lang: string;
  headings: Heading[];
  /** Post slug used to build per-language article URLs. */
  slug?: string;
  /** Languages that have an article with the same slug in this build. */
  availableIn?: Set<Locale>;
  /** Video reference from frontmatter (bilibili / youtube ids). */
  video?: { bilibili?: string; youtube?: string };
}
const {
  title,
  description,
  pubDate,
  tags,
  category,
  series,
  updated,
  excerpt,
  image,
  lang,
  headings,
  slug,
  availableIn = new Set<Locale>(),
  video,
} = Astro.props;
const code = codeFromPath(lang);
const htmlLang = languages.find((l) => l.code === code)?.htmlLang ?? "zh-CN";
// 最后修改时间:显式 updated 用之,否则回退首次发布(用户定的 fallback 规则)
const updatedAt = pubDate ? postUpdatedAt({ data: { updated, pubDate } }) : null;
const categoryLabel = category ? taxonomyLabel(categoryLabels, category, lang) : "";
const tocTitle = t(lang, "tocTitle");

// 目录有效性:仅插件分配的 6 位纯小写字母锚点 id 计入(排除 sr-only/脚注自动标题等);
// 有 h1/h2 才算有目录(起始级别逻辑见 Toc.astro),否则整页不展示目录。
// 正则与插件字符集单一来源见 src/lib/anchor.ts。
const tocHeadings = headings.filter((h) => isValidAnchorSlug(h.slug));
const hasToc = tocHeadings.length > 0 && tocHeadings.some((h) => h.depth === 1 || h.depth === 2);

const pathname = Astro.url.pathname;
const site = new URL(Astro.site ?? "https://luoyuhao.nettix.top");
const canonical = new URL(pathname, site).href;

// 活跃语言(本构建实际构建的语言):hreflang 与语言切换 targets 只覆盖它们,
// 不再为 es/ja/ko/ru/ar 生成指向 404 的链接。
const activeLangs = await getActiveLangs();

// Per-language target URLs, matched by parallel slug: when the target language has an
// article with the same slug it links to that exact article, otherwise it falls back to
// the language home (never a 404). Only active languages are generated.
const targets = {} as Record<string, string>;
for (const langEntry of activeLangs) {
  targets[langEntry.code] =
    slug && availableIn.has(langEntry.code as Locale)
      ? `/${langPath(langEntry.code)}/posts/${slug}/`
      : `/${langPath(langEntry.code)}/`;
}
---

<html lang={htmlLang} dir={htmlLang === "ar" ? "rtl" : "ltr"}>
  <head>
    <ThemeScript />
    <ViewTransitionDisable />
    <ClientRouter />
    <PostSeoHead
      title={title}
      description={description}
      lang={lang}
      canonical={canonical}
      pubDate={pubDate}
      updatedAt={updatedAt}
      tags={tags}
      category={category}
      categoryLabel={categoryLabel}
      image={image}
      langs={activeLangs}
      targets={targets}
    />
  </head>
  <body
    class="post-page flex min-h-dvh flex-col bg-surface text-text-primary antialiased"
    data-has-toc={hasToc ? "true" : undefined}
  >
    <Header lang={code} targets={targets} title={title} />

    <main id="top" class="flex-1">
      <!-- 手机端目录浮动面板(导航条"目录"按钮展开,覆盖式 fixed;见 post-toc.js) -->
      <div id="mobile-toc-panel" class="mobile-toc-panel" aria-label={tocTitle}>
        <Toc headings={tocHeadings} lang={lang} showHeading={false} />
      </div>
      <div class={`post-grid ${image ? "has-hero" : ""}`}>
        <!-- 桌面右栏:sticky TOC(>=1152px 显示,与三栏网格同断点) -->
        <aside class="post-toc hidden min-w-0 px-4 py-10" aria-label={tocTitle}>
          <Toc headings={tocHeadings} lang={lang} />
        </aside>

        <!-- 中栏:文章 -->
        <article class="post-article">
          {image && <PostHero image={image} />}

          <div class="post-header">
            <h1
            id="post-title"
            class="text-3xl font-bold tracking-tight text-brand sm:text-4xl"
          >
            {title}
          </h1>
          <PostMeta
            lang={lang}
            category={category}
            categoryLabel={categoryLabel}
            series={series}
            pubDate={pubDate}
            updatedAt={updatedAt}
            tags={tags}
          />
            {/* 分割线:标题区与正文分隔(上距与标签组收紧) */}
            <hr class="post-meta-divider mt-3" />
          </div>

          <!-- 平板(640-1151px)折叠目录:吸顶留隙;手机(<640px)隐藏,改用导航条目录按钮 + 浮动面板。 -->
          <details class="post-toc-mobile mt-6 rounded-lg border border-border bg-surface-raised">
            <summary class="cursor-pointer select-none px-4 py-3 text-sm font-semibold text-text-secondary">
              {tocTitle}
            </summary>
            <div class="toc-body px-4 py-3">
              <Toc headings={tocHeadings} lang={lang} showHeading={false} />
            </div>
          </details>

          {/* 摘要:卡片式包裹,位于目录之后;角标骑在边框线上(纸片底色挖空);正文角色字体(--font-body),随文章语言差异化;次强色保证可读 */}
          {excerpt && (
            <aside class="post-summary-card relative mx-[var(--indent)] mt-6 bg-surface-raised px-6 py-4">
              <span class="absolute -top-2.5 left-4 bg-[var(--article-bg)] px-1.5 font-mono text-xs">
                {t(lang, "summaryBadge")}
              </span>
              <p class="font-[family-name:var(--font-body)] text-sm leading-relaxed">{excerpt}</p>
            </aside>
          )}

          <div class="article-content mt-8">
            {video && (
              <VideoEmbed
                lang={lang}
                bilibili={video.bilibili}
                youtube={video.youtube}
              />
            )}
            <slot />
          </div>

          <!-- 移动端广告位(留空,槽位预留) -->
          <aside class="post-ad-mobile mt-10 lg:hidden" data-slot="ad-mobile" aria-hidden="true"></aside>

          <!-- 评论区:预留区域,默认隐藏,不加载任何评论脚本 -->
          <section id="comments" class="mt-12 hidden" aria-hidden="true" data-reserved="comments"></section>
        </article>

        <!-- 桌面左栏:广告位(留空,槽位预留) -->
        <aside class="post-ad hidden min-w-0 py-10 lg:block xl:block" aria-label="Ad">
          <div class="mb-4" data-slot="ad-1"></div>
          <div data-slot="ad-2"></div>
        </aside>
      </div>
    </main>

    <Footer lang={code} />

    <!-- Mermaid 已在构建期渲染为静态 SVG 内嵌页面(见 rehype-mermaid-ssr.mjs),
         客户端不再引入运行时 -->

    <!-- 手机端目录按钮/平板端定住玻璃质感 -->
    <script src="../scripts/post-toc.js"></script>
    <!-- 表格十字交叉 hover 高亮(行+列) -->
    <script src="../scripts/table-hover.js"></script>
    <!-- 发布时间/更新时间:按浏览器系统时区+locale 本地化(图标日期 YYYY/MM/DD,tooltip 当地语言精确到分钟) -->
    <script src="../scripts/time-localize.js"></script>
    <ScrollbarOverlay />
    <CodeBlockActions />
    <BackToTop lang={lang} />
    {/* 统计脚本放 body 末尾 + async:不阻塞解析/DOMContentLoaded,失败也无影响 */}
    <CloudflareAnalytics />
  </body>
</html>
