---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { t } from "../../i18n";

export async function getStaticPaths() {
  return ["zh", "en"].map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang ?? "zh";
---

<BaseLayout lang={lang} title="404">
  <div class="flex min-h-80 flex-col items-center justify-center px-4 text-center">
    <p class="text-5xl font-bold text-text-muted">404</p>
    <h1 class="mt-4 text-xl font-semibold">{t(lang, "notFoundTitle")}</h1>
    <p class="mt-2 text-text-secondary">{t(lang, "notFoundDesc")}</p>
    <a
      href={`/${lang}`}
      class="mt-6 inline-flex h-10 items-center justify-center rounded-full bg-action px-5 text-base font-medium text-action-contrast transition-colors hover:bg-action-hover"
    >
      {t(lang, "navHome")}
    </a>
  </div>
</BaseLayout>
