---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getActiveLangs } from "../../../lib/active-langs";
import { codeFromPath, langPath, languages, t } from "../../../i18n";
import { seriesLabels, taxonomyLabel } from "../../../taxonomy";
import BookOpenText from "../../../components/icons/BookOpenText.astro";

export async function getStaticPaths() {
  const activeLangs = await getActiveLangs();
  return activeLangs.map((lang) => ({ params: { lang: langPath(lang.code) } }));
}

const lang = codeFromPath(Astro.params.lang ?? "zh");
const prefix = `/${langPath(lang)}`;
const posts = (await getCollection("posts")).filter(
  (post) => post.data.lang === lang,
);
// 聚合当前语言的专栏:series id -> 显示名(由映射表按语言提供) + 篇数
const seriesMap = new Map<string, { title: string; count: number }>();
for (const post of posts) {
  if (!post.data.series) continue;
  const existing = seriesMap.get(post.data.series) ?? {
    title: taxonomyLabel(seriesLabels, post.data.series, lang),
    count: 0,
  };
  existing.count += 1;
  seriesMap.set(post.data.series, existing);
}
const series = [...seriesMap.entries()].sort((a, b) =>
  a[1].title.localeCompare(b[1].title, lang),
);
---

<BaseLayout
  lang={lang}
  title={t(lang, "navSeries")}
  description={t(lang, "navSeries")}
>
  <div class="page-container w-full">
    <div class="paper-list">
      <div class="paper-list-head">
        <h1>
          <span class="inline-flex items-center gap-2">
            <BookOpenText class="h-6 w-6" />
            {t(lang, "navSeries")}
          </span>
        </h1>
      </div>
      <div class="paper-list-body">
        {series.length === 0 ? (
          <div class="empty-state flex items-center justify-center rounded-lg border border-dashed border-border px-6 text-center">
            <p class="text-text-muted">{t(lang, "listEmpty")}</p>
          </div>
        ) : (
          <ul class="paper-list-rows">
            {series.map(([id, item]) => (
              <li>
                <a
                  href={`${prefix}/series/${encodeURIComponent(id)}/`}
                  class="group flex items-center justify-between gap-4 py-4 transition-colors"
                >
                  <span class="font-medium group-hover:text-brand">{item.title}</span>
                  <span class="text-sm tabular-nums text-text-muted">
                    {item.count} {t(lang, "navPosts")}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </div>
</BaseLayout>
