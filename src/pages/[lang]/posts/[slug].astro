---
import { getCollection, render } from "astro:content";
import MarkdownPostLayout from "../../../layouts/MarkdownPostLayout.astro";
import { langPath } from "../../../i18n";
import type { Locale } from "../../../i18n";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  // Slug-parallel index: which languages already publish an article for each slug,
  // so the language switcher can link to exact translated articles when they exist.
  const availableBySlug = new Map<string, Set<Locale>>();
  for (const post of posts) {
    const slug = post.id.split("/")[1];
    const langsWithSlug = availableBySlug.get(slug) ?? new Set<Locale>();
    langsWithSlug.add(post.data.lang as Locale);
    availableBySlug.set(slug, langsWithSlug);
  }
  return posts.map((post) => ({
    params: { lang: langPath(post.data.lang), slug: post.id.split("/")[1] },
    props: {
      post,
      availableIn: availableBySlug.get(post.id.split("/")[1]) ?? new Set<Locale>(),
    },
  }));
}

const { post, availableIn } = Astro.props;
const { Content, headings } = await render(post);
---

<MarkdownPostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  tags={post.data.tags}
  category={post.data.category}
  updated={post.data.updated}
  excerpt={post.data.excerpt}
  image={post.data.image}
  lang={post.data.lang}
  headings={headings}
  slug={post.id.split("/")[1]}
  availableIn={availableIn}
  video={post.data.video}
>
  <Content />
</MarkdownPostLayout>
