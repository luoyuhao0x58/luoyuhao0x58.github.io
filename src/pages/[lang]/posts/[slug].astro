---
import { getCollection, render } from "astro:content";
import MarkdownPostLayout from "../../../layouts/MarkdownPostLayout.astro";
import { langPath } from "../../../i18n";
import type { Locale } from "../../../i18n";
import { postSlug } from "../../../lib/posts";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  // Slug-parallel index: which languages already publish an article for each slug,
  // so the language switcher can link to exact translated articles when they exist.
  const availableBySlug = new Map<string, Set<Locale>>();
  for (const post of posts) {
    const slug = postSlug(post);
    const langsWithSlug = availableBySlug.get(slug) ?? new Set<Locale>();
    langsWithSlug.add(post.data.lang as Locale);
    availableBySlug.set(slug, langsWithSlug);
  }
  return posts.map((post) => {
    const slug = postSlug(post);
    return {
      params: { lang: langPath(post.data.lang), slug },
      props: {
        post,
        slug,
        availableIn: availableBySlug.get(slug) ?? new Set<Locale>(),
      },
    };
  });
}

const { post, slug, availableIn } = Astro.props;
const { Content, headings } = await render(post);
---

<MarkdownPostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  tags={post.data.tags}
  category={post.data.category}
  series={post.data.series}
  updated={post.data.updated}
  excerpt={post.data.excerpt}
  image={post.data.image}
  lang={post.data.lang}
  headings={headings}
  slug={slug}
  availableIn={availableIn}
  video={post.data.video}
>
  <Content />
</MarkdownPostLayout>
