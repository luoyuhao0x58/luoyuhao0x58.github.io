---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Pagination from "../../../../components/Pagination.astro";
import PostCard from "../../../../components/PostCard.astro";
import { codeFromPath, langPath, languages, t } from "../../../../i18n";
import { PAGE_SIZE } from "../../../../lib/pagination";

// 文章列表分页:第 2 页起在此生成(/zh/posts/page/2/ ...);第 1 页由 index.astro 承担。
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getCollection("blog");
  return languages.flatMap((lang) =>
    paginate(
      posts
        .filter((post) => post.data.lang === lang.code)
        .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
      { pageSize: PAGE_SIZE, params: { lang: langPath(lang.code) } },
    ).filter((item) => item.params.page !== undefined),
  );
};

const { page } = Astro.props;
const lang = codeFromPath(Astro.params.lang ?? "zh");
const prefix = `/${langPath(lang)}/posts`;
---

<BaseLayout lang={lang} title={t(lang, "navPosts")} description={t(lang, "navPosts")}>
  <div class="page-container w-full px-4 py-12 sm:py-16">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
      {t(lang, "navPosts")}
    </h1>
    <ul class="-mx-4 mt-10 divide-y divide-border">
      {page.data.map((post) => (
        <PostCard post={post} lang={lang} />
      ))}
    </ul>
    <Pagination lang={lang} page={page} firstPageUrl={`${prefix}/`} />
  </div>
</BaseLayout>
