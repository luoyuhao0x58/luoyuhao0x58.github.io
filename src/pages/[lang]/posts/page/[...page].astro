---
import { getCollection } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import ListLayout from "../../../../components/ListLayout.astro";
import BookText from "../../../../components/icons/BookText.astro";
import { getActiveLangs } from "../../../../lib/active-langs";
import { codeFromPath, langPath, t } from "../../../../i18n";
import { PAGE_SIZE } from "../../../../lib/pagination";

// 文章列表分页:第 2 页起在此生成(/zh/posts/page/2/ ...);第 1 页由 index.astro 承担。
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getCollection("posts");
  const activeLangs = await getActiveLangs();
  return activeLangs.flatMap((lang) =>
    paginate(
      posts
        .filter((post) => post.data.lang === lang.code)
        .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
      { pageSize: PAGE_SIZE, params: { lang: langPath(lang.code) } },
    ).filter((item) => item.params.page !== undefined),
  );
};

// getStaticPaths via paginate() supplies { page }: the props type isn't inferred,
// so declare it explicitly (matches the shape paginate() returns).
interface Props {
  page: Page<CollectionEntry<"posts">>;
}

const { page } = Astro.props;
const lang = codeFromPath(Astro.params.lang ?? "zh");
const prefix = `/${langPath(lang)}/posts`;
---

<ListLayout lang={lang} title={t(lang, "navPosts")} page={page} firstPageUrl={`${prefix}/`}>
  <BookText slot="head-icon" class="h-6 w-6" />
</ListLayout>
