---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Pagination from "../../../../components/Pagination.astro";
import PostCard from "../../../../components/PostCard.astro";
import BookText from "../../../../components/icons/BookText.astro";
import { getActiveLangs } from "../../../../lib/active-langs";
import { codeFromPath, langPath, languages, t } from "../../../../i18n";
import { PAGE_SIZE } from "../../../../lib/pagination";

// 文章列表分页:第 2 页起在此生成(/zh/posts/page/2/ ...);第 1 页由 index.astro 承担。
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getCollection("posts");
  const activeLangs = await getActiveLangs();
  return activeLangs.flatMap((lang) =>
    paginate(
      posts
        .filter((post) => post.data.lang === lang.code)
        .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
      { pageSize: PAGE_SIZE, params: { lang: langPath(lang.code) } },
    ).filter((item) => item.params.page !== undefined),
  );
};

const { page } = Astro.props;
const lang = codeFromPath(Astro.params.lang ?? "zh");
const prefix = `/${langPath(lang)}/posts`;
---

<BaseLayout lang={lang} title={t(lang, "navPosts")} description={t(lang, "navPosts")}>
  <div class="page-container w-full">
    <div class="paper-list">
      <div class="paper-list-head">
        <h1>
          <span class="inline-flex items-center gap-2">
            <BookText class="h-6 w-6" />
            {t(lang, "navPosts")}
          </span>
        </h1>
      </div>
      <div class="paper-list-body">
        <ul class="paper-list-rows">
          {page.data.map((post) => (
            <PostCard post={post} lang={lang} />
          ))}
        </ul>
        <Pagination lang={lang} page={page} firstPageUrl={`${prefix}/`} />
      </div>
    </div>
  </div>
</BaseLayout>
