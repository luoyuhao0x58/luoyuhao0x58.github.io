---
import { getCollection } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Pagination from "../../../../components/Pagination.astro";
import PostCard from "../../../../components/PostCard.astro";
import { codeFromPath, langPath, languages, t } from "../../../../i18n";
import { firstPage } from "../../../../lib/pagination";
import { tagLabels, taxonomyLabel } from "../../../../taxonomy";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const paths = [];
  for (const lang of languages) {
    const tagSet = new Set<string>();
    for (const post of posts) {
      if (post.data.lang !== lang.code) continue;
      for (const tag of post.data.tags) tagSet.add(tag);
    }
    for (const tag of tagSet) {
      paths.push({ params: { lang: langPath(lang.code), tag } });
    }
  }
  return paths;
}

const lang = codeFromPath(Astro.params.lang ?? "zh");
const tag = Astro.params.tag ?? "";
const prefix = `/${langPath(lang)}/tags/${encodeURIComponent(tag)}`;
// tag 为 taxonomy 英文 key,URL 跨语言稳定;标题按当前语言翻译
const tagTitle = `#${taxonomyLabel(tagLabels, tag, lang)}`;
// 第一页由本页静态渲染,第 2 页起由 page/[...page].astro 的 paginate 生成
const posts = (await getCollection("blog"))
  .filter((post) => post.data.lang === lang && post.data.tags.includes(tag))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const page = firstPage(posts, `${prefix}/`, prefix);
---

<BaseLayout lang={lang} title={tagTitle} description={tagTitle}>
  <div class="page-container w-full px-4 py-12 sm:py-16">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{tagTitle}</h1>
    {page.data.length === 0 ? (
      <p class="mt-10 text-text-muted">{t(lang, "listEmpty")}</p>
    ) : (
      <>
        <ul class="-mx-4 mt-10 divide-y divide-border">
          {page.data.map((post) => (
            <PostCard post={post} lang={lang} />
          ))}
        </ul>
        <Pagination lang={lang} page={page} firstPageUrl={`/${langPath(lang)}/tags/${encodeURIComponent(tag)}/`} />
      </>
    )}
  </div>
</BaseLayout>
