---
import { getCollection } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import ListLayout from "../../../../../components/ListLayout.astro";
import Tag from "../../../../../components/icons/Tag.astro";
import { getActiveLangs } from "../../../../../lib/active-langs";
import { codeFromPath, langPath } from "../../../../../i18n";
import { PAGE_SIZE } from "../../../../../lib/pagination";
import { tagLabels, taxonomyLabel } from "../../../../../taxonomy";
import { getTagCounts } from "../../../../../lib/posts";

// 标签分页:第 2 页起在此生成(/zh/tags/<tag>/page/2/ ...);第 1 页由 index.astro 承担。
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getCollection("posts");
  const tagCounts = await getTagCounts();
  const activeLangs = await getActiveLangs();
  const paths = [];
  for (const lang of activeLangs) {
    const tags = tagCounts.get(lang.code);
    if (!tags) continue;
    for (const tag of tags.keys()) {
      paths.push(
        ...paginate(
          posts
            .filter(
              (post) => post.data.lang === lang.code && post.data.tags.includes(tag),
            )
            .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
          { pageSize: PAGE_SIZE, params: { lang: langPath(lang.code), tag } },
        ).filter((item) => item.params.page !== undefined),
      );
    }
  }
  return paths;
};

// getStaticPaths via paginate() supplies { page }: the props type isn't inferred,
// so declare it explicitly (matches the shape paginate() returns).
interface Props {
  page: Page<CollectionEntry<"posts">>;
}

const { page } = Astro.props;
const lang = codeFromPath(Astro.params.lang ?? "zh");
const tag = Astro.params.tag ?? "";
const tagTitle = taxonomyLabel(tagLabels, tag, lang);
---

<ListLayout lang={lang} title={tagTitle} page={page} firstPageUrl={`/${langPath(lang)}/tags/${encodeURIComponent(tag)}/`}>
  <Tag slot="head-icon" class="h-6 w-6" />
</ListLayout>
