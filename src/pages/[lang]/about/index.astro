---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AboutHeroImage from "../../../components/about/AboutHeroImage.astro";
import AboutIntro from "../../../components/about/AboutIntro.astro";
import AboutTimeline from "../../../components/about/AboutTimeline.astro";
import AboutSkills from "../../../components/about/AboutSkills.astro";
import AboutInterests from "../../../components/about/AboutInterests.astro";
import AboutSocials from "../../../components/about/AboutSocials.astro";
import { getActiveLangs } from "../../../lib/active-langs";
import { codeFromPath, langPath, t } from "../../../i18n";

export async function getStaticPaths() {
  const activeLangs = await getActiveLangs();
  return activeLangs.map((lang) => ({ params: { lang: langPath(lang.code) } }));
}

const lang = codeFromPath(Astro.params.lang ?? "zh");
const entry = (await getCollection("about")).find((e) => e.data.lang === lang);
const { Content } = entry ? await render(entry) : { Content: undefined };
const data = entry?.data;
---

<BaseLayout lang={lang} title={data?.title ?? t(lang, "navAbout")} image={data?.image}>
  <div class="page-container w-full">
    <div class="paper-list">
      <!-- 题图(16:9 横幅,纸片最顶部顶格,与文章正文题图同处理:淡入+底部渐隐) -->
      {data?.image && <AboutHeroImage url={data.image.url} alt={data.image.alt} />}

      <!-- 纸片头:页面主题 -->
      <div class="paper-list-head">
        <h1>{data?.title ?? t(lang, "navAbout")}</h1>
      </div>

      <!-- 纸片正文 -->
      <div class="paper-list-body about-body">
        <!-- 简介 + 基本信息(区块标题"关于我") -->
        <AboutIntro lang={lang} data={data} />

        <!-- 经历时间线(倒序:最新在前) -->
        <AboutTimeline lang={lang} data={data} />

        <!-- 技术能力:名称 + 水平进度条(按熟练度降序,不显示数字) -->
        <AboutSkills lang={lang} data={data} />

        <!-- 喜好:名称 + 电池能量格(按喜好程度点亮格子,与技能横条区分) -->
        <AboutInterests lang={lang} data={data} />

        <!-- 正文长文(与文章正文样式完全一致) -->
        {Content && (
          <section class="article-content about-content mt-10">
            <Content />
          </section>
        )}

        <!-- 联系我(放文章末尾;GitHub/Email,交互与首页 hero 区一致;Email 在前) -->
        <AboutSocials lang={lang} />
      </div>
    </div>
  </div>
</BaseLayout>
