---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import Pagination from "../../../../../components/Pagination.astro";
import PostCard from "../../../../../components/PostCard.astro";
import Folder from "../../../../../components/icons/Folder.astro";
import { getActiveLangs } from "../../../../../lib/active-langs";
import { codeFromPath, langPath, languages } from "../../../../../i18n";
import { PAGE_SIZE } from "../../../../../lib/pagination";
import { categoryLabels, taxonomyLabel } from "../../../../../taxonomy";

// 分类分页:第 2 页起在此生成(/zh/category/programmer/page/2/ ...);第 1 页由 index.astro 承担。
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const CATEGORIES = Object.keys(categoryLabels);
  const posts = await getCollection("posts");
  const activeLangs = await getActiveLangs();
  return activeLangs.flatMap((lang) =>
    CATEGORIES.flatMap((category) =>
      paginate(
        posts
          .filter(
            (post) => post.data.lang === lang.code && post.data.category === category,
          )
          .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
        { pageSize: PAGE_SIZE, params: { lang: langPath(lang.code), category } },
      ).filter((item) => item.params.page !== undefined),
    ),
  );
};

const { page } = Astro.props;
const lang = codeFromPath(Astro.params.lang ?? "zh");
const category = Astro.params.category ?? "";
const categoryTitle = taxonomyLabel(categoryLabels, category, lang);
---

<BaseLayout lang={lang} title={categoryTitle} description={categoryTitle}>
  <div class="page-container w-full">
    <div class="paper-list">
      <div class="paper-list-head">
        <h1>
          <span class="inline-flex items-center gap-2">
            <Folder class="h-6 w-6" />
            {categoryTitle}
          </span>
        </h1>
      </div>
      <div class="paper-list-body">
        <ul class="paper-list-rows">
          {page.data.map((post) => (
            <PostCard post={post} lang={lang} />
          ))}
        </ul>
        <Pagination lang={lang} page={page} firstPageUrl={`/${langPath(lang)}/category/${category}/`} />
      </div>
    </div>
  </div>
</BaseLayout>
