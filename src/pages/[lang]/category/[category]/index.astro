---
import { getCollection } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Pagination from "../../../../components/Pagination.astro";
import PostCard from "../../../../components/PostCard.astro";
import Folder from "../../../../components/icons/Folder.astro";
import { getActiveLangs } from "../../../../lib/active-langs";
import { codeFromPath, langPath, languages, t } from "../../../../i18n";
import { firstPage } from "../../../../lib/pagination";
import { categoryLabels, taxonomyLabel } from "../../../../taxonomy";

export async function getStaticPaths() {
  // 分类 key 由映射表驱动,新增分类只需在 taxonomy.ts 补 key
  const CATEGORIES = Object.keys(categoryLabels);
  const activeLangs = await getActiveLangs();
  return activeLangs.flatMap((lang) =>
    CATEGORIES.map((category) => ({
      params: { lang: langPath(lang.code), category },
    })),
  );
}
const lang = codeFromPath(Astro.params.lang ?? "zh");
const category = Astro.params.category ?? "";
const prefix = `/${langPath(lang)}/category/${category}`;
const categoryTitle = taxonomyLabel(categoryLabels, category, lang);
// 第一页由本页静态渲染,第 2 页起由 page/[...page].astro 的 paginate 生成
const posts = (await getCollection("posts"))
  .filter((post) => post.data.lang === lang && post.data.category === category)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const page = firstPage(posts, `${prefix}/`, prefix);
---

<BaseLayout lang={lang} title={categoryTitle} description={categoryTitle}>
  <div class="page-container w-full">
    <div class="paper-list">
      <div class="paper-list-head">
        <h1>
          <span class="inline-flex items-center gap-2">
            <Folder class="h-6 w-6" />
            {categoryTitle}
          </span>
        </h1>
      </div>
      <div class="paper-list-body">
        {page.data.length === 0 ? (
          <div class="empty-state flex items-center justify-center rounded-lg border border-dashed border-border px-6 text-center">
            <p class="text-text-muted">{t(lang, "listEmpty")}</p>
          </div>
        ) : (
          <>
            <ul class="paper-list-rows">
              {page.data.map((post) => (
                <PostCard post={post} lang={lang} />
              ))}
            </ul>
            <Pagination lang={lang} page={page} firstPageUrl={`/${langPath(lang)}/category/${category}/`} />
          </>
        )}
      </div>
    </div>
  </div>
</BaseLayout>
