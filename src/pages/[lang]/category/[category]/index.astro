---
import { getCollection } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Pagination from "../../../../components/Pagination.astro";
import PostCard from "../../../../components/PostCard.astro";
import { codeFromPath, langPath, languages, t } from "../../../../i18n";
import { firstPage } from "../../../../lib/pagination";
import { categoryLabels, taxonomyLabel } from "../../../../taxonomy";

export async function getStaticPaths() {
  // 分类 key 由映射表驱动,新增分类只需在 taxonomy.ts 补 key
  const CATEGORIES = Object.keys(categoryLabels);
  return languages.flatMap((lang) =>
    CATEGORIES.map((category) => ({
      params: { lang: langPath(lang.code), category },
    })),
  );
}
const lang = codeFromPath(Astro.params.lang ?? "zh");
const category = Astro.params.category ?? "";
const prefix = `/${langPath(lang)}/category/${category}`;
const categoryTitle = taxonomyLabel(categoryLabels, category, lang);
// 第一页由本页静态渲染,第 2 页起由 page/[...page].astro 的 paginate 生成
const posts = (await getCollection("blog"))
  .filter((post) => post.data.lang === lang && post.data.category === category)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const page = firstPage(posts, `${prefix}/`, prefix);
---

<BaseLayout lang={lang} title={categoryTitle} description={categoryTitle}>
  <div class="page-container w-full px-4 py-12 sm:py-16">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{categoryTitle}</h1>
    {page.data.length === 0 ? (
      <p class="mt-10 text-text-muted">{t(lang, "listEmpty")}</p>
    ) : (
      <>
        <ul class="-mx-4 mt-10 divide-y divide-border">
          {page.data.map((post) => (
            <PostCard post={post} lang={lang} />
          ))}
        </ul>
        <Pagination lang={lang} page={page} firstPageUrl={`/${langPath(lang)}/category/${category}/`} />
      </>
    )}
  </div>
</BaseLayout>
