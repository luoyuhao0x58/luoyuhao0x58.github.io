---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import GitHub from "../../components/icons/GitHub.astro";
import Link from "../../components/icons/Link.astro";
import Mail from "../../components/icons/Mail.astro";
import { getActiveLangs } from "../../lib/active-langs";
import { codeFromPath, langPath, languages, t } from "../../i18n";
import { SITE } from "../../lib/site";

export async function getStaticPaths() {
  const activeLangs = await getActiveLangs();
  return activeLangs.map((lang) => ({ params: { lang: langPath(lang.code) } }));
}

const lang = codeFromPath(Astro.params.lang ?? "zh");
const prefix = `/${langPath(lang)}`;

// 精选文章:当前语言最新前 5 篇(完整列表见 /posts/ 导航)
const posts = (await getCollection("posts"))
  .filter((post) => post.data.lang === lang)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const featured = posts.slice(0, 5);

// 邮箱反爬:构建时把邮箱编码为 base64 存 data 属性,客户端 atob 解码赋值 mailto
// (静态 HTML 只出现 base64,无明文邮箱,见文件底部 <script>)
const emailB64 = btoa(`${SITE.emailUser}@${SITE.emailDomain}`);
const chipClass =
  "inline-flex items-center gap-2 rounded-full border border-border bg-(--article-bg-soft) px-4 py-1.5 text-sm text-text-secondary transition-colors hover:border-brand hover:text-brand";
---

<BaseLayout lang={lang} title={t(lang, "siteName")} description={t(lang, "heroSubtitle")}>
  <div class="page-container home w-full">
    <div class="paper-list">
      <!-- Hero:头像 + 自我介绍(与列表同纸片,统一) -->
      <div class="paper-list-hero">
        <img
          src="/avatar.png"
          alt={t(lang, "avatarAlt")}
          width={112}
          height={112}
          draggable="false"
          class="h-28 w-28 rounded-full border border-border object-cover shadow-md"
          style="background-color: var(--article-bg-soft)"
        />
        <h1 class="mt-4 text-xl font-bold tracking-tight text-text-secondary sm:text-2xl">
          {t(lang, "heroTitle")}
        </h1>
        <p class="hero-slogan mt-2.5 text-2xl font-semibold text-brand sm:text-3xl">
          {t(lang, "heroSlogan")}
        </p>
        <p class="mt-3 max-w-md leading-relaxed text-text-secondary">
          {t(lang, "heroSubtitle")}
        </p>
        <p class="hero-note mt-2.5 text-sm italic text-text-secondary">
          {t(lang, "heroNote")}
        </p>
        <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
          <a href={`${prefix}/about/`} class={chipClass}>
            <Link class="h-4 w-4" />
            {t(lang, "aboutMe")}
          </a>
          <a
            href={SITE.githubUrl}
            rel="me noopener noreferrer"
            target="_blank"
            class={chipClass}
          >
            <GitHub class="h-4 w-4" />
            GitHub
          </a>
          <a
            id="hero-email-link"
            href="#"
            class={chipClass}
            data-email-b64={emailB64}
            aria-label={`Email ${SITE.ownerName}`}
          >
            <Mail class="h-4 w-4" />
            Email
          </a>
        </div>
      </div>

      <!-- 内容分区(可扩展):此处可继续追加相册/播客/漫画等分区 -->
      <div class="paper-list-head">
        <h2>{t(lang, "latestPosts")}</h2>
      </div>
      <div class="paper-list-body">
        {featured.length === 0 ? (
          <div class="empty-state flex items-center justify-center rounded-lg border border-dashed border-border px-6 text-center">
            <p class="text-text-muted">{t(lang, "writingPlaceholder")}</p>
          </div>
        ) : (
          <ul class="paper-list-rows">
            {featured.map((post) => (
              <PostCard post={post} lang={lang} />
            ))}
          </ul>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // 邮箱反爬:data-email-b64 存 base64,atob 解码组装 mailto(静态 HTML 无明文邮箱)
  import { SITE } from "../../lib/site";
  const emailLink = document.getElementById("hero-email-link");
  if (emailLink?.dataset.emailB64) {
    const email = atob(emailLink.dataset.emailB64);
    emailLink.setAttribute("href", `mailto:${SITE.ownerName} <${email}>`);
  }
</script>
