---
// 全局 404:所有语言共用同一个极简页(用户定稿:无导航条、无其他文字,只有大 404)。
// 不依赖 BaseLayout(避免 Header/Footer/导航),独立最小 HTML;保留 ThemeScript 保证深色背景一致。
import "../styles/global.css";
import ThemeScript from "../components/ThemeScript.astro";
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" />
    <ThemeScript />
    <title>404</title>
  </head>
  <body
    class="flex min-h-dvh select-none items-center justify-center bg-surface text-text-primary antialiased"
  >
    <p class="text-8xl font-bold tracking-tight text-text-muted sm:text-9xl">404</p>
  </body>
</html>
