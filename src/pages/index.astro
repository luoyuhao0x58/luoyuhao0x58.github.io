---
// Root path: negotiate the user's preferred language and redirect with a minimal
// no-theme page (no BaseLayout) so it loads before any theme/global CSS.
import { langPath } from "../i18n";
import { getActiveLangs } from "../lib/active-langs";

// 活跃语言 = posts 有文章的语言;无文章的语言整站不渲染,跳转也不列它。
const activeLangs = await getActiveLangs();
// zh 家族显式分支(简/繁分开处理),语言不活跃时分支失效走兜底。
const zhPath = activeLangs.some((l) => l.code === "zh") ? "/zh/" : null;
const zhHantPath = activeLangs.some((l) => l.code === "zh-Hant") ? "/zh-hant/" : null;
// 非 zh 家族按浏览器语言前缀协商。
const redirectTargets = activeLangs
  .filter((lang) => lang.family !== "zh")
  .map((lang) => ({ prefix: lang.family, path: `/${langPath(lang.code)}/` }));
// 兜底:英文优先(覆盖人群最大),否则第一个活跃语言。
const fallbackLang = activeLangs.find((l) => l.code === "en") ?? activeLangs[0];
const fallbackPath = fallbackLang ? `/${langPath(fallbackLang.code)}/` : "/en/";
---

<!doctype html>
<html lang={fallbackLang?.htmlLang ?? "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={fallbackPath} />
    <meta http-equiv="refresh" content={`1;url=${fallbackPath}`} />
    <title>羽皓のBlog</title>
  </head>
  <body>
    <!-- Fallback for when neither JS nor meta refresh work: nearly invisible link into the default locale. -->
    <a
      href={fallbackPath}
      style="position: fixed; right: 8px; bottom: 8px; font-size: 12px; color: rgba(128, 128, 128, 0.18); text-decoration: none;"
    >Enter {fallbackLang?.label ?? "English"} site</a>
    <script is:inline define:vars={{ redirectTargets, zhPath, zhHantPath, fallbackPath }}>
      (function () {
        const navLang = (
          (navigator.languages && navigator.languages[0]) ||
          navigator.language ||
          "en"
        ).toLowerCase();

        // zh family first: resolve traditional variants before the generic "zh" prefix match.
        if (
          zhHantPath &&
          (navLang.startsWith("zh-tw") ||
            navLang.startsWith("zh-hk") ||
            navLang.startsWith("zh-mo") ||
            navLang.startsWith("zh-hant"))
        ) {
          location.replace(zhHantPath);
          return;
        }
        if (zhPath && navLang.startsWith("zh")) {
          location.replace(zhPath);
          return;
        }

        // Generic prefix match against other active language families.
        for (const target of redirectTargets) {
          if (navLang.startsWith(target.prefix)) {
            location.replace(target.path);
            return;
          }
        }

        location.replace(fallbackPath);
      })();
    </script>
  </body>
</html>
